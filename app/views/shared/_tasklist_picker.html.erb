<%# Wybór list zadań z trackera (wiele naraz = suma). Wybrane listy to chipy z ✕,
    kolejną dokłada się polem z podpowiedziami (datalist), bo list bywa kilkanaście,
    a szuka się po kawałku nazwy („listopad"). Każdy formularz wysyła PEŁNY nowy zestaw
    `tasklist_ids[]`; pusty element na początku zostawia parametr nawet przy zerze list.
    Mapę nazwa → id robi tasklist_picker_controller. Wymagane: id, options,
    selected_ids, url, method, refresh_url; opcjonalnie hidden_params. %>
<% hidden_params = local_assigns.fetch(:hidden_params, {}) %>
<% selected = selected_ids.filter_map { |sid| options.find { |option| option["id"] == sid.to_s } } %>
<div id="<%= id %>" class="label-filter tasklist-picker">
  <span>Lista zadań:</span>
  <% selected.each do |list| %>
    <%= form_with url: url, method: method do %>
      <%= hidden_list_params(hidden_params) %>
      <%= hidden_field_tag "tasklist_ids[]", "", id: nil %>
      <% (selected_ids - [ list["id"] ]).each do |sid| %>
        <%= hidden_field_tag "tasklist_ids[]", sid, id: nil %>
      <% end %>
      <button class="label-chip label-chip-shown tasklist-selected" title="kliknij: zdejmij tę listę">
        ✓ <%= list["name"] %> (<%= list["count"] %>) ✕
      </button>
    <% end %>
  <% end %>
  <%= form_with url: url, method: method, class: "tasklist-form",
                data: { controller: "tasklist-picker", action: "submit->tasklist-picker#resolve" } do %>
    <%= hidden_list_params(hidden_params) %>
    <% selected_ids.each do |sid| %>
      <%= hidden_field_tag "tasklist_ids[]", sid, id: nil %>
    <% end %>
    <input type="search" id="<%= id %>_input" list="<%= id %>_options" autocomplete="off" aria-label="dodaj listę zadań"
           placeholder="<%= selected.any? ? "dodaj kolejną listę…" : "wpisz, np. cykl…" %>" size="28"
           data-tasklist-picker-target="input" data-action="change->tasklist-picker#pick">
    <datalist id="<%= id %>_options">
      <% options.reject { |option| selected_ids.include?(option["id"]) }.each do |option| %>
        <option value="<%= option["name"] %>" data-id="<%= option["id"] %>" label="<%= option["count"] %> PR"></option>
      <% end %>
    </datalist>
    <input type="hidden" name="tasklist_ids[]" value="" data-tasklist-picker-target="hidden">
  <% end %>
  <% if selected_ids.any? %>
    <%= form_with url: url, method: method do %>
      <%= hidden_list_params(hidden_params) %>
      <%= hidden_field_tag "tasklist_ids[]", "", id: nil %>
      <button class="label-chip" title="zdejmij wszystkie listy">✕ bez listy</button>
    <% end %>
  <% end %>
  <%= button_to "🔄 Odśwież listy", refresh_url, class: "btn btn-small",
                title: "pobierz listy zadań z trackera od nowa (zadania bywają przepinane)" %>
</div>
